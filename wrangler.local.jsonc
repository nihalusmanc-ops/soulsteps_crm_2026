{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soulsteps-crm-local",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/webhooks/*"
    ]
  },
  "vars": {
    "APP_ENV": "local",
    "BUSINESS_TIMEZONE": "Asia/Dubai",
    "META_LIVE_INTAKE_ENABLED": "false",
    "AUTH_MODE": "access"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soulsteps-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "define": {
    "__LOCAL_DEV__": "true"
  },
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "soulsteps-private-receipts"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "JOBS_QUEUE",
        "queue": "soulsteps-local-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "soulsteps-local-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "soulsteps-local-dead-letters"
      }
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PASSWORD_HASHER",
        "class_name": "PasswordHasher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-password-hasher",
      "new_sqlite_classes": [
        "PasswordHasher"
      ]
    }
  ]
}
