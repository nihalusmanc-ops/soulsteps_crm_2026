# Server environment reference. Workers reads .dev.vars locally; never put secrets in VITE_ variables.
APP_ENV=local
BUSINESS_TIMEZONE=Asia/Dubai
ACCESS_TEAM_DOMAIN=
ACCESS_AUDIENCE=
AUTH_MODE=access
# Generate a random secret of at least 32 bytes; use Wrangler secret storage remotely.
PASSWORD_AUTH_SECRET=
META_LIVE_INTAKE_ENABLED=false
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=
