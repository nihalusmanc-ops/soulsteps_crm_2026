{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soulsteps-crm-staging",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/webhooks/*"
    ]
  },
  "vars": {
    "APP_ENV": "staging",
    "DEPLOYMENT_PLAN": "workers-free",
    "BUSINESS_TIMEZONE": "Asia/Dubai",
    "META_LIVE_INTAKE_ENABLED": "false",
    "PUBLIC_APP_URL": "https://soulsteps-crm-staging.nihalusmanc.workers.dev",
    "ACCESS_TEAM_DOMAIN": "mute-hall-89cf.cloudflareaccess.com",
    "ACCESS_AUDIENCE": "1292b38fe6b8955997216c85cb7ef35b04b60858a1cf7e80d0fbad6caddfe995"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soulsteps-staging",
      "database_id": "ee7afca5-5b69-40e9-a20e-355225a78afd",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "define": {
    "__LOCAL_DEV__": "false"
  },
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "soulsteps-staging-private-receipts"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "JOBS_QUEUE",
        "queue": "soulsteps-staging-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "soulsteps-staging-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "soulsteps-staging-dead-letters"
      }
    ]
  },
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": false
    }
  },
  "routes": [],
  "account_id": "242a0210bb9d13956b9a1eff3a9fb5d1"
}
