{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soulsteps-crm",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "APP_ENV": "production",
    "BUSINESS_TIMEZONE": "Asia/Dubai"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "soulsteps-production",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "define": {
    "__LOCAL_DEV__": "false"
  },
  "r2_buckets": [
    {
      "binding": "FILES_BUCKET",
      "bucket_name": "soulsteps-private-receipts"
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "queues": {
    "producers": [
      {
        "binding": "JOBS_QUEUE",
        "queue": "soulsteps-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "soulsteps-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "dead_letter_queue": "soulsteps-dead-letters"
      }
    ]
  }
}
